# No .env file is required to start the app.
# Optional public API URL. Leave blank until you connect a backend.
VITE_API_URL=

# Public app metadata. Name, brand, locale, home and examples: src/config/project.ts
VITE_APP_VERSION=0.0.0
VITE_APP_ENV=development

# Mock Service Worker (Development only)
# Set to 'true' to enable API mocking with MSW
VITE_MSW_ENABLED=false

# Optional service worker and asset caching (disabled by default)
VITE_PWA_ENABLED=false

# Error Tracking (Sentry)
# Get your DSN from https://sentry.io
VITE_SENTRY_DSN=

# Analytics (PostHog)
# Set to 'true' to enable analytics tracking
VITE_ANALYTICS_ENABLED=false
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://app.posthog.com
